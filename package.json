{
  "name": "praxis2",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && rm -rf ./data/postgres && docker compose up -d",
    "docker:init": "docker compose up -d && sleep 2 && pnpm db:generate && pnpm db:migrate",
    "build": "turbo build",
    "db:generate": "turbo db:generate --filter=@praxis2/api",
    "db:migrate": "turbo db:migrate --filter=@praxis2/api",
    "db:studio": "pnpm --filter @praxis2/api exec drizzle-kit studio",
    "worker:dev": "pnpm --filter @praxis2/worker dev",
    "worker:start": "pnpm --filter @praxis2/worker start",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:seed": "turbo db:seed --filter=@praxis2/api",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    }
  }
}

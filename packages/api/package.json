{
  "name": "@praxis2/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    },
    "./services/storage": {
      "types": "./dist/services/storage/index.d.ts",
      "import": "./dist/services/storage/index.js"
    },
    "./lib/propagateTaskStatus": {
      "types": "./dist/lib/propagateTaskStatus.d.ts",
      "import": "./dist/lib/propagateTaskStatus.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-roles": "tsx src/db/backfill-role-ids.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@octokit/rest": "^22.0.1",
    "@praxis2/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.0.0",
    "jose": "^5.9.0",
    "multer": "^2.1.0",
    "pg-boss": "^10.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "postgres": "^3.4.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

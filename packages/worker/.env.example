# Database connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/praxis2

# Anthropic API key for AI session handling (optional — only needed for working/debug sessions)
ANTHROPIC_API_KEY=

# Root directory for rig workspaces (required)
WORKSPACE_ROOT=/tmp/praxis-workspaces

# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Node environment (default: development)
NODE_ENV=development

# Maximum number of concurrent working sessions the worker will process (default: 10)
MAX_CONCURRENT_WORKING_SESSIONS=10
